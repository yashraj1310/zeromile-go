# =========================================================================
# ZEROMILE GO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your production environment variables
# =========================================================================

# Mapbox GL JS Public Access Token
MAPBOX_ACCESS_TOKEN=your-mapbox-public-token-placeholder
MAPBOX_STYLE=mapbox://styles/mapbox/standard

# Supabase Standalone Cloud PostgreSQL Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Operational Server Port
PORT=8080
