# ============================================================================
# VIKASIT NAGPUR / ZEROMILE GO — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MAPBOX 3D VECTOR & ROUTE ENGINE (Public Client Token)
# ----------------------------------------------------------------------------
# Used by: web_platform, web-public, cyclist_app
# Scope: Public Client
# Where to obtain: https://account.mapbox.com/ (Tokens -> Default public token)
# Required for: 3D route rendering, reverse geocoding, turn-by-turn routing
MAPBOX_ACCESS_TOKEN=your-mapbox-public-token-placeholder
MAPBOX_STYLE=mapbox://styles/mapbox/standard

# ----------------------------------------------------------------------------
# 2. SUPABASE BACKEND & REALTIME (Public Client Credentials)
# ----------------------------------------------------------------------------
# Used by: web_platform, cyclist_app, database migrations
# Scope: Public Client (Protected by Row Level Security in database)
# Where to obtain: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ----------------------------------------------------------------------------
# 3. SUPABASE PRIVILEGED CREDENTIALS (CONFIDENTIAL — SERVER / CI/CD ONLY)
# ----------------------------------------------------------------------------
# Used by: Database Migrations & Initial Developer Seeding
# Scope: CONFIDENTIAL / SECRET — NEVER expose to browser or mobile apps!
# Where to obtain: Supabase Dashboard -> Project Settings -> API (service_role secret)
# SUPABASE_SERVICE_ROLE_KEY=your-confidential-service-role-key-placeholder
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ----------------------------------------------------------------------------
# 4. WEB PLATFORM RUNTIME SERVER
# ----------------------------------------------------------------------------
# Used by: web_platform/server.js
PORT=8080

# ----------------------------------------------------------------------------
# 5. MOBILE APP DEMO & FALLBACK SETTINGS
# ----------------------------------------------------------------------------
# Used by: cyclist_app
# When DEMO_MODE=true, mobile client uses MockDataService for offline resilience
# When DEMO_MODE=false, mobile client connects directly to live Supabase backend
DEMO_MODE=true
